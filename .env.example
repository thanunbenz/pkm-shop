# =============================================================================
# PKM SHOP - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# MySQL connection string
# Format: mysql://username:password@host:port/database
DATABASE_URL="mysql://root:password@localhost:3306/pkm_shop"

# -----------------------------------------------------------------------------
# NEXTAUTH AUTHENTICATION
# -----------------------------------------------------------------------------
# Base URL of your application
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Secret key for NextAuth.js encryption
# REQUIRED: Generate with: openssl rand -base64 32
# Alternative: https://auth-secret-gen.vercel.app
NEXTAUTH_SECRET="your-secret-key-please-change-this-in-production-use-openssl-rand-base64-32"

# -----------------------------------------------------------------------------
# SESSION CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# All values have defaults in authOptions.ts - only uncomment if you need custom values
# SESSION_MAX_AGE=2592000              # Maximum session lifetime in seconds (default: 30 days)
# SESSION_UPDATE_AGE=86400             # Session refresh interval in seconds (default: 24 hours)
# SESSION_IDLE_TIMEOUT=604800000       # Idle timeout in milliseconds (default: 7 days)

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Resend API Key - Get from: https://resend.com/api-keys
# REQUIRED for email notifications (order confirmations, password resets, etc.)
RESEND_API_KEY="re_your_resend_api_key_here"

# Email sender address
# Must be a verified domain in Resend
# Format: "Name <email@domain.com>" or just "email@domain.com"
EMAIL_FROM="noreply@yourdomain.com"

# Support email (displayed in emails and footer)
# OPTIONAL: Defaults to EMAIL_FROM if not set
# EMAIL_SUPPORT="support@pkmshop.com"

# -----------------------------------------------------------------------------
# OAUTH PROVIDERS (Optional)
# -----------------------------------------------------------------------------
# Google OAuth - Get from: https://console.cloud.google.com/
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Facebook OAuth - Get from: https://developers.facebook.com/
# FACEBOOK_CLIENT_ID="your-facebook-app-id"
# FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# Environment mode: development, production, test
NODE_ENV="development"

# Next.js Configuration
# NEXT_PUBLIC_APP_URL="http://localhost:3000"  # Used for absolute URLs

# Default language for i18n (th = Thai, en = English)
# NEXT_PUBLIC_DEFAULT_LANGUAGE="th"

# -----------------------------------------------------------------------------
# CORS CONFIGURATION (Issue #79)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
# Development: Auto-allows localhost (no need to configure)
# Production: REQUIRED if API will be accessed from external domains
# Example: "https://pkmshop.com,https://www.pkmshop.com,https://app.pkmshop.com"
# ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# -----------------------------------------------------------------------------
# MONITORING & LOGGING (Optional)
# -----------------------------------------------------------------------------
# Sentry Error Tracking - Get from: https://sentry.io/
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY (Future Use)
# -----------------------------------------------------------------------------
# PromptPay Configuration (when Issue #40 is implemented)
# PROMPTPAY_API_KEY=""
# PROMPTPAY_MERCHANT_ID=""

# -----------------------------------------------------------------------------
# STORAGE & UPLOADS
# -----------------------------------------------------------------------------
# Upload directory (relative to public folder)
# UPLOAD_DIR="uploads"
# MAX_UPLOAD_SIZE=5242880  # 5MB in bytes

# -----------------------------------------------------------------------------
# RATE LIMITING (Optional - defaults are in rateLimit.ts)
# -----------------------------------------------------------------------------
# RATE_LIMIT_AUTH=5           # Authentication attempts per minute
# RATE_LIMIT_ADMIN=10         # Admin operations per minute
# RATE_LIMIT_WRITE=20         # Write operations per minute
# RATE_LIMIT_PUBLIC=30        # Public endpoints per minute

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate NEXTAUTH_SECRET: openssl rand -base64 32
# 3. Set up MySQL database and update DATABASE_URL
# 4. Create Resend account and add RESEND_API_KEY
# 5. Update EMAIL_FROM with your verified domain
# 6. Run database migrations: npx prisma migrate dev
# 7. (Optional) Configure OAuth providers if needed
# =============================================================================

# =============================================================================
# SECURITY NOTES
# =============================================================================
# ⚠️  NEVER commit .env file to version control
# ⚠️  Use strong, unique values for all secrets in production
# ⚠️  Rotate secrets regularly (especially NEXTAUTH_SECRET)
# ⚠️  Use environment-specific values (dev, staging, prod)
# ⚠️  Keep backup of production environment variables
# =============================================================================
