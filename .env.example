# Database
# MySQL connection string
# Format: mysql://username:password@host:port/database
DATABASE_URL="mysql://root:password@localhost:3306/pkm_shop"

# NextAuth Configuration
# IMPORTANT: Change these values in production!
NEXTAUTH_URL="http://localhost:3000"
#https://auth-secret-gen.vercel.app
NEXTAUTH_SECRET="your-secret-key-please-change-this-in-production-use-openssl-rand-base64-32"

# OAuth Providers (Optional)
# Google OAuth - Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth - Get from: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# App Configuration
NODE_ENV="development"

# JWT (Deprecated - use NEXTAUTH_SECRET instead)
# JWT_SECRET="your-jwt-secret"

# Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. Generate NEXTAUTH_SECRET with: openssl rand -base64 32
