generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  USER
  OPERATOR
  ADMIN
}

enum ProductStatus {
  PACK
  BOX
  PROMO
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  DELIVER
}

model User {
  id           Int            @id @default(autoincrement())
  fname        String
  lname        String
  email        String         @unique
  password     String?
  createdAt    DateTime       @default(now())
  role         UserStatus     @default(USER)
  Account      Account[]
  RefreshToken RefreshToken[]
  Purchase     Purchase[]
  Cart         Cart[]
  AuditLog     AuditLog[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Product {
  id            Int           @id @default(autoincrement())
  name          String
  description   String?       @db.Text
  price         Float
  discountprice Float
  issale        Boolean
  isrecommend   Boolean
  image         String?       @db.Text
  imageId       String?       @default("-")
  category      ProductStatus @default(PACK)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  code          Code[]
  Purchase      Purchase[]
  Cart          Cart[]

  @@index([issale])
  @@index([isrecommend])
  @@index([category])
}

model File {
  id        Int      @id @default(autoincrement())
  name      String
  path      String   @db.Text
  size      Int
  createdAt DateTime @default(now())
}

model Code {
  id           Int            @id @default(autoincrement())
  code         String         @unique
  isUsed       Boolean        @default(false)
  createdAt    DateTime       @default(now())
  productId    Int
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  PurchaseCode PurchaseCode[]

  @@index([productId])
  @@index([isUsed])
}

model Purchase {
  id            Int            @id @default(autoincrement())
  userId        Int
  productId     Int
  quantity      Int            @default(1)
  totalAmount   Float
  status        OrderStatus    @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  purchaseCodes PurchaseCode[]
  payment       Payment?

  @@index([userId])
  @@index([productId])
  @@index([status])
}

model PurchaseCode {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  codeId     Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  code       Code     @relation(fields: [codeId], references: [id])

  @@unique([purchaseId, codeId])
  @@index([purchaseId])
  @@index([codeId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  purchaseId    Int           @unique
  paymentMethod String        @default("manual") // manual, promptpay, truewallet, etc.
  paymentStatus PaymentStatus @default(PENDING)
  transactionId String?
  paymentProof  String?       @db.Text // URL to payment proof image
  adminNotes    String?       @db.Text // Admin notes for manual verification
  paidAt        DateTime?     // Timestamp when payment was verified
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  purchase      Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([paymentStatus])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  image       String   @db.Text
  imageId     String?
  link        String?  @db.Text
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

model SiteSettings {
  id              Int      @id @default(autoincrement())
  welcomeTitle    String   @default("Welcome to PKM Shop")
  welcomeSubtitle String?  @db.Text
  showWelcome     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  userId      Int         // Admin/Operator who performed the action
  action      AuditAction // Type of action (CREATE, UPDATE, DELETE, etc.)
  resource    String      // Resource type (Product, Code, Purchase, Banner, etc.)
  resourceId  String      // ID of the affected resource
  description String      @db.Text // Human-readable description
  metadata    String?     @db.Text // JSON string with additional details
  ipAddress   String?     // IP address of the admin
  userAgent   String?     @db.Text // User agent string
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
}
